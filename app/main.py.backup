from fastapi import FastAPI, HTTPException, BackgroundTasks
from pydantic import BaseModel, Field, validator
from google.cloud import bigquery, storage
from datetime import datetime
from typing import List
import json
import os

app = FastAPI(title="Globant Data Migration API", version="1.0.0")

PROJECT_ID = os.getenv("GCP_PROJECT_ID")
DATASET_ID = "globant_migration"
DLQ_BUCKET = f"{PROJECT_ID}-dlq"

bq_client = bigquery.Client(project=PROJECT_ID)
storage_client = storage.Client(project=PROJECT_ID)

class Employee(BaseModel):
    id: int = Field(..., gt=0)
    name: str = Field(..., min_length=1)
    datetime: str
    department_id: int = Field(..., gt=0)
    job_id: int = Field(..., gt=0)

    @validator("datetime")
    def validate_datetime(cls, v):
        try:
            datetime.fromisoformat(v.replace("Z", "+00:00"))
            return v
        except ValueError:
            raise ValueError("Invalid ISO datetime format")

class Department(BaseModel):
    id: int = Field(..., gt=0)
    department: str = Field(..., min_length=1)

class Job(BaseModel):
    id: int = Field(..., gt=0)
    job: str = Field(..., min_length=1)

class BatchRequest(BaseModel):
    table: str = Field(..., pattern="^(employees|departments|jobs)$")
    data: List[dict] = Field(..., min_items=1, max_items=1000)

def log_to_dlq(table: str, invalid_records: List[dict]):
    if not invalid_records:
        return
    try:
        bucket = storage_client.bucket(DLQ_BUCKET)
        timestamp = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
        blob = bucket.blob(f"dlq/{table}/{timestamp}.json")
        blob.upload_from_string(
            json.dumps(invalid_records, indent=2),
            content_type="application/json"
        )
    except Exception as e:
        print(f"DLQ write failed: {e}")

def get_validator(table: str):
    validators = {
        "employees": Employee,
        "departments": Department,
        "jobs": Job
    }
    return validators.get(table)

@app.post("/ingest")
async def ingest_batch(request: BatchRequest, background_tasks: BackgroundTasks):
    validator = get_validator(request.table)
    if not validator:
        raise HTTPException(400, "Invalid table name")

    valid_records = []
    invalid_records = []

    for record in request.data:
        try:
            validated = validator(**record)
            valid_records.append(validated.dict())
        except Exception as e:
            invalid_records.append({"record": record, "error": str(e)})

    if invalid_records:
        background_tasks.add_task(log_to_dlq, request.table, invalid_records)

    if valid_records:
        table_ref = f"{PROJECT_ID}.{DATASET_ID}.{request.table}"
        job_config = bigquery.LoadJobConfig(
            write_disposition=bigquery.WriteDisposition.WRITE_APPEND,
            source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
        )

        try:
            load_job = bq_client.load_table_from_json(
                valid_records, table_ref, job_config=job_config
            )
            load_job.result()
        except Exception as e:
            raise HTTPException(500, f"BigQuery insert failed: {str(e)}")

    return {
        "inserted": len(valid_records),
        "rejected": len(invalid_records),
        "table": request.table
    }

@app.post("/backup/{table}")
async def backup_table(table: str):
    if table not in ["employees", "departments", "jobs"]:
        raise HTTPException(400, "Invalid table name")

    table_ref = f"{PROJECT_ID}.{DATASET_ID}.{table}"
    bucket_name = f"{PROJECT_ID}-backups"
    timestamp = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
    destination_uri = f"gs://{bucket_name}/backups/{table}/{timestamp}_*.avro"

    job_config = bigquery.ExtractJobConfig()
    job_config.destination_format = bigquery.DestinationFormat.AVRO

    try:
        extract_job = bq_client.extract_table(
            table_ref,
            destination_uri,
            job_config=job_config
        )
        extract_job.result()
        
        return {
            "status": "success",
            "table": table,
            "backup_uri": destination_uri,
            "timestamp": timestamp
        }
    except Exception as e:
        raise HTTPException(500, f"Backup failed: {str(e)}")

@app.post("/restore/{table}")
async def restore_table(table: str, backup_timestamp: str):
    if table not in ["employees", "departments", "jobs"]:
        raise HTTPException(400, "Invalid table name")

    source_uri = f"gs://{PROJECT_ID}-backups/backups/{table}/{backup_timestamp}_*.avro"
    table_ref = f"{PROJECT_ID}.{DATASET_ID}.{table}"

    job_config = bigquery.LoadJobConfig(
        source_format=bigquery.SourceFormat.AVRO,
        write_disposition=bigquery.WriteDisposition.WRITE_TRUNCATE,
    )

    try:
        load_job = bq_client.load_table_from_uri(
            source_uri, table_ref, job_config=job_config
        )
        load_job.result()
        
        return {
            "status": "success",
            "table": table,
            "restored_from": source_uri
        }
    except Exception as e:
        raise HTTPException(500, f"Restore failed: {str(e)}")

@app.get("/metrics/quarterly-hires")
async def quarterly_hires():
    query = """
    WITH quarterly_data AS (
        SELECT 
            d.department,
            j.job,
            EXTRACT(QUARTER FROM PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%SZ', e.datetime)) as quarter,
            COUNT(*) as hires
        FROM `{project}.{dataset}.employees` e
        JOIN `{project}.{dataset}.departments` d ON e.department_id = d.id
        JOIN `{project}.{dataset}.jobs` j ON e.job_id = j.id
        WHERE EXTRACT(YEAR FROM PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%SZ', e.datetime)) = 2021
        GROUP BY department, job, quarter
    )
    SELECT 
        department,
        job,
        COALESCE(MAX(IF(quarter = 1, hires, 0)), 0) as Q1,
        COALESCE(MAX(IF(quarter = 2, hires, 0)), 0) as Q2,
        COALESCE(MAX(IF(quarter = 3, hires, 0)), 0) as Q3,
        COALESCE(MAX(IF(quarter = 4, hires, 0)), 0) as Q4
    FROM quarterly_data
    GROUP BY department, job
    ORDER BY department, job
    """.format(project=PROJECT_ID, dataset=DATASET_ID)

    try:
        results = bq_client.query(query).result()
        return [dict(row) for row in results]
    except Exception as e:
        raise HTTPException(500, f"Query failed: {str(e)}")

@app.get("/metrics/above-mean-hires")
async def above_mean_hires():
    query = """
    WITH dept_hires AS (
        SELECT 
            d.id,
            d.department,
            COUNT(*) as hired
        FROM `{project}.{dataset}.employees` e
        JOIN `{project}.{dataset}.departments` d ON e.department_id = d.id
        WHERE EXTRACT(YEAR FROM PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%SZ', e.datetime)) = 2021
        GROUP BY d.id, d.department
    ),
    mean_calc AS (
        SELECT AVG(hired) as mean_hired
        FROM dept_hires
    )
    SELECT 
        dh.id,
        dh.department,
        dh.hired
    FROM dept_hires dh
    CROSS JOIN mean_calc mc
    WHERE dh.hired > mc.mean_hired
    ORDER BY dh.hired DESC
    """.format(project=PROJECT_ID, dataset=DATASET_ID)

    try:
        results = bq_client.query(query).result()
        return [dict(row) for row in results]
    except Exception as e:
        raise HTTPException(500, f"Query failed: {str(e)}")

@app.get("/health")
async def health():
    return {"status": "healthy", "service": "globant-migration-api"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=int(os.getenv("PORT", 8080)))
