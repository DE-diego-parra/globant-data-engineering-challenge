, "relation_name": "`globant-migration-1777674652`.`globant_migration_staging`.`jobs`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-02T15:16:01.013506Z", "completed_at": "2026-05-02T15:16:01.054084Z"}, {"name": "execute", "started_at": "2026-05-02T15:16:01.060630Z", "completed_at": "2026-05-02T15:16:01.060676Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.05810379981994629, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.globant_dbt.dept_performance", "compiled": true, "compiled_code": "WITH dept_hires AS (\n    SELECT \n        d.id,\n        d.department,\n        COUNT(*) as hired\n    FROM `globant-migration-1777674652`.`globant_migration_staging`.`employees` e\n    JOIN `globant-migration-1777674652`.`globant_migration_staging`.`departments` d ON e.department_id = d.id\n    WHERE EXTRACT(YEAR FROM TIMESTAMP(e.datetime)) = 2021\n    GROUP BY d.id, d.department\n),\nmean_calc AS (\n    SELECT AVG(hired) as mean_hired\n    FROM dept_hires\n)\nSELECT \n    dh.id,\n    dh.department,\n    dh.hired,\n    ROUND(mc.mean_hired, 2) as mean_hired,\n    ROUND(dh.hired - mc.mean_hired, 2) as diff_from_mean\nFROM dept_hires dh\nCROSS JOIN mean_calc mc\nWHERE dh.hired > mc.mean_hired\nORDER BY dh.hired DESC", "relation_name": "`globant-migration-1777674652`.`globant_migration_marts`.`dept_performance`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-02T15:16:01.024752Z", "completed_at": "2026-05-02T15:16:01.057426Z"}, {"name": "execute", "started_at": "2026-05-02T15:16:01.061592Z", "completed_at": "2026-05-02T15:16:01.061615Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.05841255187988281, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.globant_dbt.not_null_stg_employees_department_id.a7701eed35", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect department_id\nfrom `globant-migration-1777674652`.`globant_migration_staging`.`employees`\nwhere department_id is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-02T15:16:01.045589Z", "completed_at": "2026-05-02T15:16:01.058738Z"}, {"name": "execute", "started_at": "2026-05-02T15:16:01.062426Z", "completed_at": "2026-05-02T15:16:01.062448Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.05916094779968262, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.globant_dbt.not_null_stg_employees_id.c1aff1262d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect id\nfrom `globant-migration-1777674652`.`globant_migration_staging`.`employees`\nwhere id is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-02T15:16:01.019321Z", "completed_at": "2026-05-02T15:16:01.059595Z"}, {"name": "execute", "started_at": "2026-05-02T15:16:01.063311Z", "completed_at": "2026-05-02T15:16:01.063331Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.06249284744262695, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.globant_dbt.quarterly_hires", "compiled": true, "compiled_code": "WITH quarterly_data AS (\n    SELECT \n        d.department,\n        j.job,\n        EXTRACT(QUARTER FROM TIMESTAMP(e.datetime)) as quarter,\n        COUNT(*) as hires\n    FROM `globant-migration-1777674652`.`globant_migration_staging`.`employees` e\n    JOIN `globant-migration-1777674652`.`globant_migration_staging`.`departments` d ON e.department_id = d.id\n    JOIN `globant-migration-1777674652`.`globant_migration_staging`.`jobs` j ON e.job_id = j.id\n    WHERE EXTRACT(YEAR FROM TIMESTAMP(e.datetime)) = 2021\n    GROUP BY department, job, quarter\n)\nSELECT \n    department,\n    job,\n    COALESCE(MAX(IF(quarter = 1, hires, 0)), 0) as Q1,\n    COALESCE(MAX(IF(quarter = 2, hires, 0)), 0) as Q2,\n    COALESCE(MAX(IF(quarter = 3, hires, 0)), 0) as Q3,\n    COALESCE(MAX(IF(quarter = 4, hires, 0)), 0) as Q4,\n    SUM(hires) as total_hires\nFROM quarterly_data\nGROUP BY department, job\nORDER BY department, job", "relation_name": "`globant-migration-1777674652`.`globant_migration_marts`.`quarterly_hires`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-02T15:16:01.084105Z", "completed_at": "2026-05-02T15:16:01.095152Z"}, {"name": "execute", "started_at": "2026-05-02T15:16:01.096600Z", "completed_at": "2026-05-02T15:16:01.096624Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.02401447296142578, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.globant_dbt.unique_stg_employees_id.19f6c2604f", "compiled": true, "compiled_code": "\n    \n    \n\nwith dbt_test__target as (\n\n  select id as unique_field\n  from `globant-migration-1777674652`.`globant_migration_staging`.`employees`\n  where id is not null\n\n)\n\nselect\n    unique_field,\n    count(*) as n_records\n\nfrom dbt_test__target\ngroup by unique_field\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-02T15:16:01.077213Z", "completed_at": "2026-05-02T15:16:01.095897Z"}, {"name": "execute", "started_at": "2026-05-02T15:16:01.097394Z", "completed_at": "2026-05-02T15:16:01.097414Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.026448726654052734, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.globant_dbt.not_null_stg_employees_job_id.7c440098ef", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect job_id\nfrom `globant-migration-1777674652`.`globant_migration_staging`.`employees`\nwhere job_id is null\n\n\n", "relation_name": null, "batch_results": null}], "elapsed_time": 0.846766471862793, "args": {"log_format_file": "debug", "log_level": "info", "use_f